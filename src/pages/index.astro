---
import Base from "../layouts/Base.astro";
import { site } from "../config";

const personSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  alternateName: "José María Bravo",
  url: "https://josemariabravo.com",
  email: `mailto:${site.email}`,
  jobTitle: "Operations & Finance — Fintech, Payments & FX",
  image: "https://josemariabravo.com/headshot.jpg",
  nationality: ["Mexican", "Spanish"],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Mexico City",
    addressCountry: "MX",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universidad Anáhuac",
  },
  knowsLanguage: ["es", "en"],
  sameAs: [
    site.linkedin,
    `https://github.com/${site.github}`,
    site.goodreadsProfileUrl,
  ].filter(Boolean),
});

const capabilities = [
  {
    idx: "A",
    title: "Operations & finance leadership",
    text: "Margin analysis, process redesign, exception handling, executive reporting.",
  },
  {
    idx: "B",
    title: "Data & product",
    text: "Python, SQL, BI dashboards, AI-assisted workflows, end-to-end delivery.",
  },
  {
    idx: "C",
    title: "Strategy & business development",
    text: "Market analysis, partnerships, commercial negotiation.",
  },
  {
    idx: "D",
    title: "Regulated environments",
    text: "AML/CFT (CNBV/UIF), governance, discretion with confidential information.",
  },
];
---

<Base title="José María Bravo — Operations & Finance × Product/Data">
  <script type="application/ld+json" set:html={personSchema} />

  <section class="hero">
    <div class="hero-main">
      <span class="badge">Open to opportunities</span>
      <h1>José María<br />Bravo<br />Quintana</h1>
      <p class="tagline">
        I build the systems a business runs on — and I run the business too.
      </p>
    </div>
    <aside class="hero-facts">
      <img
        class="headshot"
        src="/headshot.jpg"
        alt="Portrait of José María Bravo Quintana"
        width="576"
        height="720"
      />
      <div>
        <div class="label">Focus</div>
        <div class="fact">
          Operations &amp; Finance × Product/Data — Fintech, Payments &amp; FX
        </div>
      </div>
      <div>
        <div class="label">Locations</div>
        <div class="fact">CDMX · Madrid · London · NYC · Chicago</div>
      </div>
      <div>
        <div class="label">Citizenship</div>
        <div class="fact">Mexican + Spanish (EU) — no EU sponsorship needed</div>
      </div>
      <div>
        <div class="label">Languages</div>
        <div class="fact">Spanish (native) · English (native)</div>
      </div>
      <div class="cta">
        <a class="button primary" href={`mailto:${site.email}`}>Get in touch</a>
        <a class="button" href="/cv.pdf">CV ↓</a>
      </div>
    </aside>
  </section>

  <section class="capabilities">
    {
      capabilities.map((c) => (
        <div class="cap">
          <div class="cap-idx">{c.idx}</div>
          <h3>{c.title}</h3>
          <p class="muted small">{c.text}</p>
        </div>
      ))
    }
  </section>

  <section>
    <h2>About</h2>
    <p class="about">
      I'm an operator with a builder's toolkit. At a cross-border FX and
      money-transmission company I lead operations and finance while also
      designing and shipping the data, product, and compliance stack: the
      analytics leadership runs on, an automated AML/CFT monitoring engine, and
      a governed knowledge base. In parallel, I founded and run
      <strong>ALCOBA</strong>, a real-estate management company with a portfolio
      of owned units plus 18 apartments under management.
    </p>
    <ul class="explore">
      <li>
        <a href="/experience/"><span class="idx">01</span>Experience</a>
        <span class="muted">
          — engineering → energy → sales → founding a company → fintech.</span
        >
      </li>
      <li>
        <a href="/projects/"><span class="idx">02</span>Projects</a>
        <span class="muted">
          — public code and the professional systems I've built.</span
        >
      </li>
      <li>
        <a href="/reading/"><span class="idx">03</span>Reading</a>
        <span class="muted"> — what's on my shelf.</span>
      </li>
    </ul>
  </section>

  <section>
    <h2>Contact</h2>
    <p>
      The fastest way to reach me is email:
      <a href={`mailto:${site.email}`}>{site.email}</a>. I'm also on
      <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a> and
      <a href={`https://github.com/${site.github}`} target="_blank" rel="noopener"
        >GitHub</a
      >.
    </p>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 3rem;
    padding: 2rem 0 3rem;
  }
  .hero-main .badge {
    margin-bottom: 2rem;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 7vw, 5.1rem);
    line-height: 0.98;
    margin-bottom: 1.6rem;
  }
  .tagline {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.45;
    max-width: 34rem;
    margin: 0;
  }
  .hero-facts {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    border-left: 1px solid var(--rule);
    padding-left: 2rem;
    padding-top: 0.5rem;
  }
  .fact {
    font-size: 0.9rem;
    font-weight: 500;
    margin-top: 0.2rem;
  }
  .headshot {
    width: 100%;
    max-width: 260px;
    height: auto;
    display: block;
    border: 1px solid var(--rule);
  }
  .cta {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }
  .capabilities {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
  }
  .cap {
    padding: 1.6rem 1.4rem 1.8rem 0;
    border-right: 1px solid var(--hairline);
    padding-left: 1.4rem;
  }
  .cap:first-child {
    padding-left: 0;
  }
  .cap:last-child {
    border-right: none;
  }
  .cap-idx {
    font-family: "Space Grotesk", "Helvetica Neue", sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--accent);
    margin-bottom: 0.7rem;
  }
  .cap h3 {
    font-size: 0.95rem;
    margin-bottom: 0.35rem;
    font-family: "Archivo", "Helvetica Neue", sans-serif;
    font-weight: 600;
  }
  .small {
    font-size: 0.82rem;
    line-height: 1.55;
    margin-bottom: 0;
  }
  .about {
    max-width: 46rem;
  }
  .explore {
    list-style: none;
    margin-top: 1.5rem;
  }
  .explore li {
    margin-bottom: 0.7rem;
  }
  .explore a {
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.9rem;
  }
  .explore .idx {
    color: var(--muted);
    margin-right: 0.5rem;
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .hero-facts {
      border-left: none;
      border-top: 1px solid var(--rule);
      padding-left: 0;
      padding-top: 1.5rem;
    }
    .capabilities {
      grid-template-columns: 1fr;
    }
    .cap {
      border-right: none;
      border-bottom: 1px solid var(--hairline);
      padding-left: 0;
    }
    .cap:last-child {
      border-bottom: none;
    }
  }
</style>
